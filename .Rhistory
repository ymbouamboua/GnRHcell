wang = readRDS("~/projects/singlecell/10x-data/data/Wang_GSE212901_RAW/wang.rds")
set.seed(123)
hpsc_gnrh <- wang[, sample(colnames(wang), 300)]
hpsc_gnrh <- Seurat::NormalizeData(hpsc_gnrh, verbose = FALSE)
hpsc_gnrh <- Seurat::FindVariableFeatures(hpsc_gnrh, verbose = FALSE)
hpsc_gnrh <- Seurat::ScaleData(hpsc_gnrh, verbose = FALSE)
hpsc_gnrh <- Seurat::RunPCA(hpsc_gnrh, verbose = FALSE)
hpsc_gnrh <- Seurat::RunUMAP(
hpsc_gnrh,
dims = 1:10,
min.dist = 1.5,
verbose = FALSE
)
hpsc_gnrh@misc <- list()
hpsc_gnrh@commands <- list()
usethis::use_data(
hpsc_gnrh,
overwrite = TRUE,
compress = "xz"
)
