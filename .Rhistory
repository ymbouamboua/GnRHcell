utils::globalVariables(scan_globals_ast("R"))
scan_globals_ast <- function(path = "R") {
files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
globals <- character()
for (f in files) {
exprs <- parse(f)
vars <- all.names(exprs)
globals <- c(globals, vars)
}
safe <- c(
"if","for","while","function","return",
"TRUE","FALSE","NULL","NA",
"mean","median","sum","min","max",
"length","c","list","data.frame"
)
globals <- setdiff(unique(globals), safe)
globals <- globals[!grepl("^\\d", globals)]
sort(globals)
}
utils::globalVariables(scan_globals_ast("R"))
devtools::load_all()
source("dev/scan_globals.R")
scan_globals_ast <- function(path = "R") {
files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
txt <- paste(unlist(lapply(files, readLines, warn = FALSE)), collapse = "\n")
# extract only symbols used in non-standard evaluation contexts
# (aes, $, and data masking patterns)
dollar_vars <- unique(regmatches(txt, gregexpr("(?<=\\$)[a-zA-Z_\\.][a-zA-Z0-9_\\.]*", txt, perl = TRUE)))
aes_vars <- unique(regmatches(txt, gregexpr("aes\$begin:math:text$\(\.\*\?\)\\$end:math:text$", txt, perl = TRUE)))
scan_globals_ast <- function(path = "R") {
files <- list.files(path, pattern = "\\.R$", full.names = TRUE)
txt <- paste(unlist(lapply(files, readLines, warn = FALSE)), collapse = "\n")
# -----------------------------
# 1. Extract $-access variables
# -----------------------------
dollar_vars <- unique(
regmatches(
txt,
gregexpr("\\$[a-zA-Z_\\.][a-zA-Z0-9_\\.]*", txt, perl = TRUE)
)[[1]]
)
dollar_vars <- sub("^\\$", "", dollar_vars)
# -----------------------------
# 2. Extract aes() variables (ggplot NSE)
# -----------------------------
aes_blocks <- regmatches(
txt,
gregexpr("aes\\(([^)]*)\\)", txt, perl = TRUE)
)[[1]]
aes_vars <- unique(unlist(
regmatches(aes_blocks, gregexpr("[a-zA-Z_][a-zA-Z0-9_]*", aes_blocks))
))
# -----------------------------
# 3. Combine
# -----------------------------
globals <- unique(c(dollar_vars, aes_vars))
# -----------------------------
# 4. Remove obvious noise
# -----------------------------
safe <- c(
"c", "df", "obj", "x", "y", "i", "j",
"TRUE", "FALSE", "NULL"
)
globals <- setdiff(globals, safe)
sort(globals)
}
globals <- scan_globals_ast("R")
cat(utils::globalVariables(globals))
