secreting = toupper(c(
"PCSK1", "PCSK2", "CPE",
"SYP", "VAMP2", "RAB3A", "RAB3B", "RAB3C",
"SCG2", "SCG5", "BAIAP3", "PTPRN",
"TAC3", "TAC1", "KISS1R",
"DOC2B", "CADPS", "SLC18A1",
"PCSK1N", "RAB27B", "PLD5"
))
)
# =========================================================
# 3. Helper functions
# =========================================================
assign_gnrh_program <- function(genes, modules) {
genes <- unique(toupper(genes))
out <- lapply(names(modules), function(program) {
hits <- intersect(genes, modules[[program]])
if (length(hits) == 0) {
return(NULL)
}
data.frame(
gene = hits,
program = program,
stringsAsFactors = FALSE
)
})
out <- Filter(Negate(is.null), out)
if (length(out) == 0) {
return(data.frame(
gene = character(0),
program = character(0),
stringsAsFactors = FALSE
))
}
do.call(rbind, out)
}
classify_known_status <- function(gene) {
gene <- toupper(gene)
if (gene %in% known_gnrh_markers) {
return("known_GnRH_or_developmental")
}
if (gene %in% generic_neuronal) {
return("generic_neuronal")
}
if (gene %in% candidate_novel) {
return("candidate_novel")
}
"unknown_or_context_specific"
}
safe_col <- function(df, col, default = NA) {
if (col %in% colnames(df)) {
return(df[[col]])
}
rep(default, nrow(df))
}
compute_specificity_score <- function(df) {
avg_log2FC <- suppressWarnings(as.numeric(safe_col(df, "avg_log2FC", 0)))
pct1 <- suppressWarnings(as.numeric(safe_col(df, "pct.1", 0)))
pct2 <- suppressWarnings(as.numeric(safe_col(df, "pct.2", 0)))
padj <- suppressWarnings(as.numeric(safe_col(df, "p_val_adj", 1)))
score <- avg_log2FC * (pct1 - pct2) * -log10(padj + 1e-300)
score[is.na(score)] <- 0
score
}
assign_confidence <- function(df) {
high <- (
df$coexpr_GNRH1 == TRUE &
df$specificity_score > 1 &
df$known_status %in% c("candidate_novel", "known_GnRH_or_developmental")
)
medium <- (
df$coexpr_GNRH1 == TRUE &
df$specificity_score > 0.25 &
df$known_status != "generic_neuronal"
)
ifelse(
high,
"high",
ifelse(medium, "medium", "low")
)
}
# =========================================================
# 4. Main function
# =========================================================
build_gnrh_candidate_marker_table <- function(
files,
results,
outdir,
modules = gnrh_stage_modules,
coexpr_col = "coexpr_flag"
) {
out <- lapply(names(files), function(dataset) {
marker_file <- file.path(outdir, "tables", files[[dataset]])
if (!file.exists(marker_file)) {
warning("Missing file: ", marker_file)
return(NULL)
}
markers <- read.delim(
marker_file,
sep = "\t",
stringsAsFactors = FALSE
)
if (!"gene" %in% colnames(markers)) {
warning("Missing gene column in: ", dataset)
return(NULL)
}
markers$gene <- toupper(markers$gene)
if (!coexpr_col %in% colnames(markers)) {
warning("Missing co-expression column in: ", dataset)
markers[[coexpr_col]] <- FALSE
}
unique_genes <- toupper(results$unique[[dataset]])
keep_genes <- unique(c(unique_genes, "GNRH1"))
df <- markers[markers$gene %in% keep_genes, , drop = FALSE]
if (nrow(df) == 0) {
return(NULL)
}
program_df <- assign_gnrh_program(df$gene, modules)
if (nrow(program_df) == 0) {
df$program <- NA_character_
} else {
df$program <- program_df$program[
match(df$gene, program_df$gene)
]
}
df$dataset <- dataset
df$is_unique <- df$gene %in% unique_genes
df$coexpr_GNRH1 <- df[[coexpr_col]] == TRUE
df$known_status <- vapply(
df$gene,
classify_known_status,
character(1)
)
df$specificity_score <- compute_specificity_score(df)
df$confidence_level <- assign_confidence(df)
df[, c(
"dataset",
"gene",
"is_unique",
"known_status",
"program",
"coexpr_GNRH1",
"specificity_score",
"confidence_level"
)]
})
out <- Filter(Negate(is.null), out)
if (length(out) == 0) {
return(data.frame())
}
final <- do.call(rbind, out)
final <- final[
order(
final$confidence_level,
final$dataset,
final$program,
-final$specificity_score
),
]
rownames(final) <- NULL
final
}
# =========================================================
# 5. Run
# =========================================================
candidate_table <- build_gnrh_candidate_marker_table(
files = files,
results = results,
outdir = outdir,
modules = gnrh_stage_modules
)
candidate_table
# =========================================================
# 6. High-confidence candidates only
# =========================================================
high_confidence_candidates <- subset(
candidate_table,
confidence_level == "high" &
is_unique == TRUE &
coexpr_GNRH1 == TRUE
)
high_confidence_candidates
# =========================================================
# 7. Summary by dataset and program
# =========================================================
candidate_summary <- aggregate(
gene ~ dataset + program + confidence_level,
data = high_confidence_candidates,
FUN = function(x) paste(sort(unique(x)), collapse = ", ")
)
