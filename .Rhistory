files <- c(
"HuDeCa Nose" = "gnrh_hudeca_nose_markers.tsv",
#"Wang 2022" = "gnrh_wang_markers.tsv",
"Human HypoMap" = "gnrh_human_hypomap_markers.tsv"
#"Mouse HypoMap" = "gnrh_mouse_hypomap_markers.tsv",
#"HuDeCa Hypo" = "gnrh_hudeca_hypo_markers.tsv",
#"Human ME" = "gnrh_hme_markers.tsv"
#"Mouse POA" = "gnrh_mouse_poa_markers.tsv",
#"Mouse MBH" = "gnrh_mouse_mbh_markers.tsv"
)
mouse_sets <- c(
"Mouse HypoMap",
"Mouse POA",
"Mouse MBH"
)
gene_sets <- imap(files, function(f, nm) {
genes <- read.delim2(
file.path(outdir, f),
sep = "\t"
) %>%
pull(gene) %>%
unique()
if (nm %in% mouse_sets) {
genes <- toupper(genes)
}
genes
})
results <- gene_upset(
gene_sets = gene_sets,plot_width = 14,
venn_title = "Overlap of Co-expressed Marker Genes",
outdir = file.path(outdir, "vs_human_nose_wang_hypomap_markers")
)
# View plot
results$venn_plot
results$common_all
cellfeat(wang, "SIX3")
cellfeat(wang, "PPP1R17")
cellfeat(wang, "PTPRN")
cellfeat(wang, "KISS1R")
cellfeat(wang, "SLC18A1")
cellfeat(wang, "SLC35F3")
