linewidth = 0.9
) +
annotate(
"text",
x = 6.25,
y = 3.42,
label = "Cell-state map",
color = white,
fontface = "bold",
size = 4.4
) +
geom_point(
data = umap,
aes(
x = x + 4.5,
y = y + 1.8,
color = group
),
size = 0.9,
alpha = 0.85
) +
scale_color_manual(
values = c(
identity = cyan,
migration = purple,
mature = orange
),
guide = "none"
) +
# Trajectory panel
geom_rect(
aes(xmin = 7.6, xmax = 8.85, ymin = 2.05, ymax = 3.6),
fill = panel,
color = green,
linewidth = 0.9
) +
annotate(
"text",
x = 8.225,
y = 3.42,
label = "Trajectory",
color = white,
fontface = "bold",
size = 4.4
) +
geom_segment(
aes(x = 7.85, y = 2.65, xend = 8.6, yend = 2.95),
color = muted,
linewidth = 1
) +
geom_point(
aes(
x = c(7.85, 8.1, 8.35, 8.6),
y = c(2.65, 2.75, 2.85, 2.95)
),
color = c(cyan, "#3B82F6", purple, orange),
size = 4
) +
annotate(
"text",
x = 8.22,
y = 2.28,
label = "identity → mature",
color = muted,
size = 3.1
) +
# Network panel
geom_rect(
aes(xmin = 9.15, xmax = 11.1, ymin = 2.05, ymax = 3.6),
fill = panel,
color = orange,
linewidth = 0.9
) +
annotate(
"text",
x = 10.125,
y = 3.42,
label = "Marker network",
color = white,
fontface = "bold",
size = 4.4
) +
geom_segment(
data = network_edges,
aes(
x = x,
y = y,
xend = xend,
yend = yend
),
color = muted,
linewidth = 0.8,
alpha = 0.7
) +
geom_point(
data = network_nodes,
aes(x = x, y = y),
color = cyan,
fill = panel2,
shape = 21,
size = 6,
stroke = 1.2
) +
geom_text(
data = network_nodes,
aes(x = x, y = y - 0.18, label = label),
color = white,
size = 2.7
) +
# Bottom key message
geom_rect(
aes(xmin = 0.7, xmax = 11.3, ymin = 0.45, ymax = 1.35),
fill = "#101827",
color = cyan,
linewidth = 1
) +
annotate(
"text",
x = 6.0,
y = 0.92,
label = "Key message: GnRH identity is a coherent developmental transcriptional program — not a single GNRH1 signal.",
color = white,
fontface = "bold",
size = 4.6
)
ggsave(
"GnRHcell_workflow_VECTOR.pdf",
p,
width = 16,
height = 9,
device = cairo_pdf,
bg = bg
)
