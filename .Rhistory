files <- c(
"HuDeCa Nose" = "gnrh_hudeca_nose_markers.tsv",
"Wang 2022" = "gnrh_wang_markers.tsv",
"Human HypoMap" = "gnrh_human_hypomap_markers.tsv",
"Mouse HypoMap" = "gnrh_mouse_hypomap_markers.tsv",
"HuDeCa Hypo" = "gnrh_hudeca_hypo_markers.tsv",
"Human ME" = "gnrh_hme_markers.tsv",
"Mouse POA" = "gnrh_mouse_poa_markers.tsv",
"Mouse MBH" = "gnrh_mouse_mbh_markers.tsv"
)
mouse_sets <- c(
"Mouse HypoMap",
"Mouse POA",
"Mouse MBH"
)
gene_sets <- imap(files, function(f, nm) {
genes <- read.delim2(
file.path(outdir, f),
sep = "\t"
) %>%
pull(gene) %>%
unique()
if (nm %in% mouse_sets) {
genes <- toupper(genes)
}
genes
})
# Generate one plot per dataset
iwalk(gene_sets, function(genes, dataset_name) {
df <- markers %>%
filter(
coexpr_flag == TRUE,
gene %in% genes
)
p <- plot_gnrh_coexpr(
df,
coexp_cutoff = 0.3
) +
ggtitle(dataset_name)
filename <- paste0(
"gnrh_coexpr_",
gsub("[^A-Za-z0-9]", "_", dataset_name)
)
savefig(
p,
filename = file.path(root, filename),
width = 5,
height = 6,
format = "png"
)
})
