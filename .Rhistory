gnrh_report <- function(object, style = "test", verbose = TRUE) {
log <- .msg(verbose)
log("Generating GnRH QC report")
stopifnot(inherits(object, "Seurat"))
g <- object@misc$gnrh
if (is.null(g)) stop("Missing @misc$gnrh")
diag  <- g$diagnostics
curve <- g$threshold_curve
roc_obj <- NULL
if (!is.null(diag$truth) && length(unique(diag$truth)) == 2) {
roc_obj <- pROC::roc(diag$truth, diag$expr, quiet = TRUE)
}
panels  <- .gnrh_panel_list(diag, roc_obj, style)
grouped <- .gnrh_panel_groups(panels)
final <- .gnrh_layout_grouped(grouped, max_col = 3)
final +
patchwork::plot_annotation(title = "GnRH Diagnostic Report") &
theme(
plot.margin = margin(10, 10, 10, 10),
panel.spacing = unit(1, "lines")
)
}
gnrh_report(wang)
.gnrh_panel_list <- function(diag, roc_obj, style) {
list(
signal     = .gnrh_panel_signal(diag, style),
density    = .gnrh_panel_density(diag, style),
threshold  = .gnrh_panel_threshold(diag, style),
roc        = .gnrh_panel_roc(roc_obj, style),
hits       = .gnrh_panel_hits(diag, style),
enrichment = .gnrh_panel_enrichment(diag, style),
class      = .gnrh_panel_class(diag, style),
status     = .gnrh_panel_status(diag, style)
)
}
.gnrh_panel_groups <- function(panels) {
clean <- function(x) Filter(Negate(is.null), x)
list(
signal         = clean(list(panels$signal)),
distribution   = clean(list(panels$density)),
validation     = clean(list(panels$roc, panels$threshold)),
scoring        = clean(list(panels$hits, panels$enrichment)),
classification = clean(list(panels$class)),
composition    = clean(list(panels$status))
)
}
.gnrh_layout_grouped <- function(grouped, max_col = 3) {
plots <- unlist(grouped, recursive = FALSE)
plots <- Filter(function(p) inherits(p, "ggplot"), plots)
if (length(plots) == 0) {
return(ggplot2::ggplot() + ggplot2::theme_void())
}
ncol <- min(max_col, max(1, ceiling(sqrt(length(plots)))))
patchwork::wrap_plots(plots, ncol = ncol)
}
gnrh_report <- function(object, style = "test", verbose = TRUE) {
log <- .msg(verbose)
log("Generating GnRH QC report")
stopifnot(inherits(object, "Seurat"))
g <- object@misc$gnrh
if (is.null(g)) stop("Missing @misc$gnrh")
diag  <- g$diagnostics
curve <- g$threshold_curve
roc_obj <- NULL
if (!is.null(diag$truth) && length(unique(diag$truth)) == 2) {
roc_obj <- pROC::roc(diag$truth, diag$expr, quiet = TRUE)
}
panels  <- .gnrh_panel_list(diag, roc_obj, style)
grouped <- .gnrh_panel_groups(panels)
final <- .gnrh_layout_grouped(grouped, max_col = 3)
final +
patchwork::plot_annotation(title = "GnRH Diagnostic Report") &
theme(
plot.margin = margin(10, 10, 10, 10),
panel.spacing = unit(1, "lines")
)
}
gnrh_report(wang)
