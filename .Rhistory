df <- .safe_table_df(diag$class, "class")
.safe_df <- function(x, required = NULL, min_rows = 1) {
if (is.null(x) || !is.data.frame(x)) return(NULL)
if (nrow(x) < min_rows) return(NULL)
if (!is.null(required)) {
if (!all(required %in% colnames(x))) return(NULL)
}
x <- x[stats::complete.cases(x), , drop = FALSE]
if (nrow(x) < min_rows) return(NULL)
x
}
df <- .safe_table_df(diag$class, "class")
df <- .safe_df(diag$class, "class")
df
diag
.safe_table_df <- function(x, name = "group") {
if (is.null(x) || length(x) == 0) {
return(data.frame(
group = character(),
n = integer(),
stringsAsFactors = FALSE
))
}
x <- x[!is.na(x)]
if (length(x) == 0) {
return(data.frame(
group = character(),
n = integer(),
stringsAsFactors = FALSE
))
}
tab <- table(x, useNA = "no")
df <- data.frame(
group = names(tab),
n = as.integer(tab),
stringsAsFactors = FALSE
)
colnames(df)[1] <- name
df
}
df <- .safe_table_df(diag$class, "class")
