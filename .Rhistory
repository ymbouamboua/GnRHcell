tools::showNonASCIIfile("R/visualization.R")
x <- readLines("R/visualization.R", warn = FALSE)
x <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT")
x <- gsub("\u2013|\u2014", "-", x)
x <- gsub("\u2192", "->", x)
x <- gsub("\u2265", ">=", x)
x <- gsub("\u2264", "<=", x)
x <- gsub("\u2018|\u2019", "'", x)
x <- gsub("\u201c|\u201d", "\"", x)
writeLines(x, "R/visualization.R")
tools::showNonASCIIfile("R/visualization.R")
