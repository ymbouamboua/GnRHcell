#obj <- JoinLayers(obj)
obj[["RNA"]] <- split(obj[["RNA"]], f = obj$status)
obj <- NormalizeData(obj)
obj <- FindVariableFeatures(obj)
obj <- ScaleData(obj)
obj <- RunPCA(obj, npcs = 50)
obj <- FindNeighbors(obj, dims = 1:50, reduction = "pca")
obj <- FindClusters(obj, resolution = 0.5, cluster.name = "unintegrated_clusters")
obj <- IntegrateLayers(object = obj, method = HarmonyIntegration, orig.reduction = "pca", new.reduction = "harmony")
ndims <- get_pcs(obj)
obj <- RunUMAP(obj, reduction = "pca", dims = 1:ndims, min.dist = 1, spread = 1)
obj <- FindNeighbors(obj, reduction = "pca", dims = 1:ndims)
obj <- FindClusters(obj, resolution = c(0.6))
obj <- JoinLayers(obj)
cellmap(object = obj, group.by = "seurat_clusters", label = T)
cellmap(object = obj, group.by = "status")
saveRDS(obj, file.path(outdir, "data/harmony.rds"))
