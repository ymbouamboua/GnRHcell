# =========================================================
# 4. Main function
# =========================================================
build_gnrh_candidate_marker_table <- function(
files,
results,
outdir,
modules = gnrh_stage_modules,
coexpr_col = "coexpr_flag"
) {
out <- lapply(names(files), function(dataset) {
marker_file <- file.path(outdir, "tables", files[[dataset]])
if (!file.exists(marker_file)) {
warning("Missing file: ", marker_file)
return(NULL)
}
markers <- read.delim(
marker_file,
sep = "\t",
stringsAsFactors = FALSE
)
if (!"gene" %in% colnames(markers)) {
warning("Missing gene column in: ", dataset)
return(NULL)
}
markers$gene <- toupper(markers$gene)
if (!coexpr_col %in% colnames(markers)) {
warning("Missing co-expression column in: ", dataset)
markers[[coexpr_col]] <- FALSE
}
unique_genes <- toupper(results$unique[[dataset]])
keep_genes <- unique(c(unique_genes, "GNRH1"))
df <- markers[markers$gene %in% keep_genes, , drop = FALSE]
if (nrow(df) == 0) {
return(NULL)
}
program_df <- assign_gnrh_program(df$gene, modules)
if (nrow(program_df) == 0) {
df$program <- NA_character_
} else {
df$program <- program_df$program[
match(df$gene, program_df$gene)
]
}
df$dataset <- dataset
df$is_unique <- df$gene %in% unique_genes
df$coexpr_GNRH1 <- df[[coexpr_col]] == TRUE
df$known_status <- vapply(
df$gene,
classify_known_status,
character(1)
)
df$specificity_score <- compute_specificity_score(df)
df$confidence_level <- assign_confidence(df)
df[, c(
"dataset",
"gene",
"is_unique",
"known_status",
"program",
"coexpr_GNRH1",
"specificity_score",
"confidence_level"
)]
})
out <- Filter(Negate(is.null), out)
if (length(out) == 0) {
return(data.frame())
}
final <- do.call(rbind, out)
final <- final[
order(
final$confidence_level,
final$dataset,
final$program,
-final$specificity_score
),
]
rownames(final) <- NULL
final
}
# =========================================================
# 5. Run
# =========================================================
candidate_table <- build_gnrh_candidate_marker_table(
files = files,
results = results,
outdir = outdir,
modules = gnrh_stage_modules
)
candidate_table
# =========================================================
# 6. Candidate selection
# =========================================================
candidate_table$program[is.na(candidate_table$program)] <- "unassigned"
candidate_table$confidence_level <- "low"
candidate_table$confidence_level[
candidate_table$is_unique == TRUE &
candidate_table$coexpr_GNRH1 == TRUE
] <- "medium"
candidate_table$confidence_level[
candidate_table$is_unique == TRUE &
candidate_table$coexpr_GNRH1 == TRUE &
candidate_table$program != "unassigned"
] <- "high"
high_confidence_candidates <- subset(
candidate_table,
confidence_level == "high"
)
high_confidence_candidates
# =========================================================
# 7. Summary by dataset and program
# =========================================================
if (nrow(high_confidence_candidates) == 0) {
message("No high-confidence candidates found. Using medium-confidence candidates.")
candidate_for_summary <- subset(
candidate_table,
confidence_level %in% c("high", "medium") &
is_unique == TRUE &
coexpr_GNRH1 == TRUE
)
} else {
candidate_for_summary <- high_confidence_candidates
}
if (nrow(candidate_for_summary) == 0) {
candidate_summary <- data.frame(
dataset = character(0),
program = character(0),
confidence_level = character(0),
gene = character(0),
n_genes = integer(0),
stringsAsFactors = FALSE
)
} else {
candidate_summary <- aggregate(
gene ~ dataset + program + confidence_level,
data = candidate_for_summary,
FUN = function(x) paste(sort(unique(x)), collapse = ", ")
)
candidate_summary$n_genes <- sapply(
strsplit(candidate_summary$gene, ", "),
length
)
candidate_summary <- candidate_summary[
order(candidate_summary$dataset, candidate_summary$program),
]
}
candidate_summary
# =========================================================
# 8. Export
# =========================================================
write.table(
candidate_table,
file = file.path(outdir, "tables", "gnrh_candidate_marker_table.tsv"),
sep = "\t",
quote = FALSE,
row.names = FALSE
)
write.table(
high_confidence_candidates,
file = file.path(outdir, "tables", "gnrh_high_confidence_candidate_markers.tsv"),
sep = "\t",
quote = FALSE,
row.names = FALSE
)
write.table(
candidate_summary,
file = file.path(outdir, "tables", "gnrh_candidate_marker_summary_by_program.tsv"),
sep = "\t",
quote = FALSE,
row.names = FALSE
)
split(
high_confidence_candidates$gene,
list(
high_confidence_candidates$dataset,
high_confidence_candidates$program
)
)
