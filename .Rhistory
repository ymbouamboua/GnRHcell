diag <- hpsc_gnrh@misc$gnrh$diagnostics
# GNRH expression vs total module hits
ggplot2::ggplot(diag, ggplot2::aes(hits_total, expr, color = status)) +
ggplot2::geom_point(alpha = 0.7) +
ggplot2::scale_color_manual(values = gnrh_colors("status")) +
ggplot2::labs(
title = "GNRH1 expression vs module support",
x = "Total module hits",
y = "GNRH1 expression"
) +
plot_theme(style = style)
# GNRH expression vs total module hits
ggplot2::ggplot(diag, ggplot2::aes(hits_total, expr, color = status)) +
ggplot2::geom_point(alpha = 0.7) +
ggplot2::scale_color_manual(values = gnrh_colors("status")) +
ggplot2::labs(
title = "GNRH1 expression vs module support",
x = "Total module hits",
y = "GNRH1 expression"
) +
plot_theme(style = "classic")
diag <- hpsc_gnrh@misc$gnrh$diagnostics
diag$hits_total <- diag$core_hits + diag$mig_hits + diag$neuro_hits
ggplot2::ggplot(diag, ggplot2::aes(hits_total, expr, color = status)) +
ggplot2::geom_point(alpha = 0.7, size = 1.2) +
ggplot2::scale_color_manual(values = gnrh_colors("status")) +
ggplot2::labs(
title = "GNRH1 expression vs module support",
x = "Total module hits",
y = "GNRH1 expression"
) +
plot_theme(style = "classic")
diag <- hpsc_gnrh@misc$gnrh$diagnostics
ggplot2::ggplot(
diag,
ggplot2::aes(
x = core_hits + mig_hits + neuro_hits,
y = expr,
color = status
)
) +
ggplot2::geom_point(alpha = 0.7, size = 1.2) +
ggplot2::scale_color_manual(values = gnrh_colors("status")) +
ggplot2::labs(
title = "GNRH1 expression vs module support",
x = "Total module hits",
y = "GNRH1 expression"
) +
plot_theme(style = "classic")
